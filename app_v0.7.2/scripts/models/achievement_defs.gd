static func get_def(id: String) -> Dictionary:
	for d in LIST:
		if d["id"] == id:
			return d
	return {}


static func text(d: Dictionary, field: String, lang: String) -> String:
	var t: Dictionary = d[field]
	return t.get(lang, t["en"])
